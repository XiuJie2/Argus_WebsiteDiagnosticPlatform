# Strix agent 服務設定範例。複製成 .env（勿提交）。

# Phase 0：stub 模式，零 LLM／零 Docker／零真實攻擊流量。接線驗證期維持 true。
STRIX_STUB=true

# Argus → 本服務的 Bearer 金鑰（須與 Argus 的 ARGUS_AGENT_SERVICE_KEY 相同）。
# 留空＝不驗 Bearer（僅限隔離內網）。
STRIX_SERVICE_API_KEY=

# ---- 以下僅 real mode（STRIX_STUB=false）需要 ----
# Strix headless 設定
STRIX_BIN=strix
STRIX_SCAN_MODE=quick            # quick|standard|deep
STRIX_MAX_BUDGET_USD=10          # 成本硬上限，由本服務統一 clamp
STRIX_MAX_TURNS=200
STRIX_RUN_TIMEOUT=1500           # 須 < Argus ARGUS_AGENT_SERVICE_TIMEOUT（預設 1800）
STRIX_RUNS_DIR=/work/strix_runs

# 只有隔離 demo（掃自架 Juice Shop 等私網靶機）才設 true；生產一律 false。
STRIX_ALLOW_PRIVATE_TARGETS=false

# Strix 引擎本身需要（本服務的部署需求，不是 Argus 的）
# STRIX_LLM=openrouter/z-ai/glm-5.3
# LLM_API_KEY=
