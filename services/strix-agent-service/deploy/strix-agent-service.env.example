# 複製成 /etc/strix-agent-service.env 並 chmod 600。
# 把 STRIX_SERVICE_API_KEY 的 REPLACE_WITH_ARGUS_AGENT_SERVICE_KEY 換成 argus .env
# 的 ARGUS_AGENT_SERVICE_KEY 值。⚠ 不要把金鑰寫進任何「註解行」。
STRIX_STUB=false
STRIX_BIN=/root/.strix/bin/strix
STRIX_SERVICE_API_KEY=REPLACE_WITH_ARGUS_AGENT_SERVICE_KEY

# ── 深度 vs 成本（見 app/config.py 的完整說明）──────────────────────────────
# Strix 沒有「限制 agent 數量」的旗標，deep/standard 會開很多平行子代理 →
# 更深必然更多 token。實測 naive standard 一次燒 1.148 億 token（且被時間上限砍斷）。
# 下面三個旋鈕直擊「重送 context」的根因，讓 standard 可負擔：
STRIX_SCAN_MODE=standard          # quick | standard | deep
STRIX_MAX_TURNS=40                # 每個 agent 的回合上限
STRIX_RUN_TIMEOUT=1800            # wall-clock 硬上限（秒）；argus 逾時要 > 這個值
STRIX_REASONING_EFFORT=medium     # 思考型模型(MiniMax M3)的 token 主因；high→medium 大降
LLM_DISABLE_STREAMING=true        # 關 streaming，消掉「streamed 重試重送全 context」的浪費
STRIX_PROMPT_CACHE=true           # 重複 context 走快取（Strix 預設即 true）

STRIX_ALLOW_PRIVATE_TARGETS=false
STRIX_RUNS_DIR=/root/strix-service-runs
HOME=/root
# 提醒：argus 後台 agent「逾時」要 > STRIX_RUN_TIMEOUT（目前 2100 > 1800）。
