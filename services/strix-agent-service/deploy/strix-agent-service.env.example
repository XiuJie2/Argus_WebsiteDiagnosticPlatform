# 複製成 /etc/strix-agent-service.env 並 chmod 600。
# STRIX_SERVICE_API_KEY 換成 argus .env 的 ARGUS_AGENT_SERVICE_KEY（勿寫進註解）。
STRIX_STUB=false

# 引擎：用 pip 版 strix + 啟動器（deploy/strix-engine-launch.py）。
# 啟動器會在跑 strix 前註冊 MiniMax 的合成每 token 價格，讓 --max-budget 真的生效
# （獨立執行檔的 litellm 不認得 MiniMax → 成本恆 0 → budget 失效、會把額度用爆）。
STRIX_BIN=/root/strix-engine/launch.py

STRIX_SERVICE_API_KEY=REPLACE_WITH_ARGUS_AGENT_SERVICE_KEY

# Layer 2：quick 預設（子代理少、便宜；完整度靠跨掃描累積）。要單次更深改 standard/deep。
STRIX_SCAN_MODE=quick

# Layer 1（核心）：硬性花費上限。合成價 $1/1M token（STRIX_PRICE_PER_MTOKEN），
# 所以 budget 的數字 ≈ 百萬 token 數：30 ≈ 3,000 萬 token 就讓 strix 自己乾淨收尾。
# 這是「成本 vs 完整度」的旋鈕。實測：deep 配 $8 會在確認漏洞前就停（0 發現），
# 所以要嘛 budget 給夠、要嘛用 quick。
STRIX_MAX_BUDGET_USD=30
STRIX_PRICE_PER_MTOKEN=1.0
# 要給特定 model 定價可加（預設已涵蓋常見 MiniMax 變體）：
# STRIX_PRICE_MODELS=MiniMax-M3.1-Flash,MiniMax-M3

# wall-clock 只當後備（高於正常完成時間）；真正的煞車是 budget。
STRIX_RUN_TIMEOUT=2400
STRIX_REASONING_EFFORT=medium
LLM_DISABLE_STREAMING=true
STRIX_PROMPT_CACHE=true
STRIX_ALLOW_PRIVATE_TARGETS=false
STRIX_RUNS_DIR=/root/strix-service-runs
HOME=/root
# 提醒：argus 後台 agent「逾時」要 > STRIX_RUN_TIMEOUT（目前 2700 > 2400）。
