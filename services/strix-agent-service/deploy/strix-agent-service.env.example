# 複製成 /etc/strix-agent-service.env，chmod 600，把 <KEY> 換成
# argus 專案 .env 裡的 ARGUS_AGENT_SERVICE_KEY 值。
STRIX_STUB=false
STRIX_BIN=/root/.strix/bin/strix
STRIX_SERVICE_API_KEY=<KEY>
STRIX_SCAN_MODE=quick
STRIX_MAX_TURNS=25
STRIX_RUN_TIMEOUT=1500
STRIX_ALLOW_PRIVATE_TARGETS=false
STRIX_RUNS_DIR=/root/strix-service-runs
HOME=/root
